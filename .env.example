# LinkedIn account credentials
LINKEDIN_USERNAME=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# SQLAlchemy database URL
DATABASE_URL=sqlite:///data/connection_machine.db

# OpenRouter API key for AI-generated invite notes, connect detection, and feed comments
OPENROUTER_API_KEY=

# OpenRouter model used by every LLM module. Defaults to google/gemini-3.7-flash
# when unset.
LLM_MODEL=google/gemini-3.7-flash
# Per-module overrides. Each falls back to LLM_MODEL, then to the built-in
# default. Leave blank to use LLM_MODEL for everything.
# Invite note generation
LLM_MODEL_CONNECTION_MESSAGE=
# Shortening pass applied when a note or comment exceeds its length limit
LLM_MODEL_REFINE_TEXT=
# Autonomous feed comments
LLM_MODEL_FEED_COMMENT=
# Connect-button detection (needs a vision-capable model)
LLM_MODEL_CONNECT_ACTION=

# Invite audience filter. Checked live on every profile visit — a queued task
# for a person who fails the filter is skipped (reason: audience_filter).
# Fails closed: if a threshold is set and the stat is not visible on the
# profile topcard, the person is skipped.
# Minimum follower count required to send an invite (0 = disabled)
INVITE_MIN_FOLLOWERS=0
# Require the profile to show "500+ connections" (true/false)
INVITE_REQUIRE_500_CONNECTIONS=false
# Minimum seconds between invite profile visits, regardless of outcome. A
# rejected prospect does not consume the daily spacing, so the dispatcher would
# otherwise burst through the queue hunting for a match — a profile-view rate
# that trips LinkedIn's bot detection. Randomized ±30%. 0 disables the throttle.
INVITE_MIN_VISIT_INTERVAL_SECONDS=90

# Browser settings
HEADLESS=true
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9102

# Optional notification settings
TELEGRAM_NOTIFICATIONS_URL=
TELEGRAM_CHAT_ID=
TELEGRAM_API_KEY=
